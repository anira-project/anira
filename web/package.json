{
  "name": "@anira-project/anira",
  "version": "3.0.0-alpha.2",
  "license": "Apache-2.0",
  "homepage": "https://github.com/anira-project/anira",
  "repository": {
    "type": "git",
    "url": "https://github.com/anira-project/anira.git",
    "directory": "web"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./scope": {
      "types": "./dist/scope.d.ts",
      "import": "./dist/scope.js"
    },
    "./engines/onnxruntime-web": {
      "types": "./dist/engines/onnxruntime-web.d.ts",
      "import": "./dist/engines/onnxruntime-web.js"
    },
    "./wasm/*": "./dist/wasm/*"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && vite build",
    "test": "node --experimental-strip-types --no-warnings --import ./test/resolve-ts.mjs --test test/*.test.ts",
    "examples": "tsc -p examples/stage-and-engine && vite build --config examples/stage-and-engine/vite.config.ts && tsc -p examples/model-file && vite build --config examples/model-file/vite.config.ts",
    "dev": "vite build --watch",
    "format": "prettier . --write"
  },
  "devDependencies": {
    "@emnapi/core": "^1.10.0",
    "@emnapi/runtime": "^1.10.0",
    "prettier": "^3.8.3",
    "rollup": "^4.60.0",
    "typescript": "~5.9.3",
    "vite": "^8.0.8",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-static-copy": "^3.2.0"
  },
  "dependencies": {
    "onnxruntime-web": "^1.19.2"
  },
  "packageManager": "npm@11.6.2"
}
