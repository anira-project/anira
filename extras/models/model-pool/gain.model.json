{
  "models": [
    {
      "engine": "libtorch",
      "path": "example-models/SimpleGainNetwork/models/simple_gain_network_mono.pt"
    },
    {
      "engine": "onnxruntime",
      "path": "example-models/SimpleGainNetwork/models/simple_gain_network_mono.onnx"
    },
    {
      "engine": "tflite",
      "path": "example-models/SimpleGainNetwork/models/simple_gain_network_mono.tflite",
      "tensors": { "gain": { "layout": [0, "insert", "insert"] } }
    },
    {
      "engine": "litert",
      "path": "example-models/SimpleGainNetwork/models/simple_gain_network_mono.tflite",
      "tensors": {
        "gain": { "layout": [0, "insert", "insert"] },
        "audio_out": { "name": "output_0" },
        "gain_out": { "name": "output_1" }
      }
    },
    {
      "engine": "executorch",
      "path": "example-models/SimpleGainNetwork/models/simple_gain_network_mono.pte"
    }
  ],
  "inputs": [
    {
      "name": "audio_in",
      "dtype": "float32",
      "role": "streamed",
      "axes": [["batch", 1], ["channel", 1], ["time", 512]],
      "window": { "min": 512, "max": 512 }
    },
    {
      "name": "gain",
      "dtype": "float32",
      "role": "static",
      "axes": [["any", 1]]
    }
  ],
  "outputs": [
    {
      "name": "audio_out",
      "dtype": "float32",
      "role": "streamed",
      "axes": [["batch", 1], ["channel", 1], ["time", 512]],
      "window": { "min": 512, "max": 512 }
    },
    {
      "name": "gain_out",
      "dtype": "float32",
      "role": "static",
      "axes": [["any", 1]]
    }
  ]
}
