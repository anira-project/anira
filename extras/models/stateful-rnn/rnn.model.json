{
  "models": [
    {
      "engine": "libtorch",
      "path": "stateful-lstm/models/model_0/stateful-lstm-dynamic.pt"
    },
    {
      "engine": "onnxruntime",
      "path": "stateful-lstm/models/model_0/stateful-lstm-libtorch.onnx"
    },
    {
      "engine": "tflite",
      "path": "stateful-lstm/models/model_0/stateful-lstm-dynamic.tflite",
      "tensors": {
        "audio_in": { "layout": [1, 0, 2] },
        "audio_out": { "layout": [1, 0, 2] }
      }
    },
    {
      "engine": "litert",
      "path": "stateful-lstm/models/model_0/stateful-lstm-dynamic.tflite",
      "tensors": {
        "audio_in": { "layout": [1, 0, 2] },
        "audio_out": { "layout": [1, 0, 2] }
      }
    },
    {
      "engine": "executorch",
      "path": "stateful-lstm/models/model_0/stateful-lstm-executorch.pte"
    }
  ],
  "state": "stateful",
  "inputs": [
    {
      "name": "audio_in",
