  ],
  "outputs": [
    {
      "name": "audio_out",
      "dtype": "float32",
      "role": "streamed",
      "axes": [["time", 2048], ["batch", 1], ["channel", 1]],
      "window": { "min": 2048, "max": 2048 }
    }
  ]
}
