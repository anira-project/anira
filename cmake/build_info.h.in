/*
 * anira/abi/build_info.h — generated by cmake/build-info.cmake at configure time from
 * `git describe`. Do not edit; do not commit. Installed next to the committed
 * anira/abi/ headers.
 */
#ifndef ANIRA_ABI_BUILD_INFO_H
#define ANIRA_ABI_BUILD_INFO_H

#include <stdint.h>

/**
 * @file build_info.h
 * @brief Release identity of this anira build: the semver triple, the full
 * `git describe` string and the ABI pair, all derived from the git tag.
 *
 * The ABI pair (`ANIRA_ABI_MAJOR`.`ANIRA_ABI_MINOR`) numbers the promise of the
 * `anira/abi/` headers and is never written by hand:
 *  - `vX.0.0-alpha.N` / `-beta.N` before the first `X.Y.Z` release: `0.N`, one running
 *    counter over every `vX.0.0-*` tag reachable from HEAD (alpha.1..3 then beta.1..2
 *    give 0.1 .. 0.5);
 *  - `vX.Y.Z` with `X >= 3`: `X.Y` (the ABI minor equals the semver minor; a patch
 *    release never changes the headers);
 *  - a checkout past a tag reports the next minor, so a development header never claims
 *    a released promise it exceeds;
 *  - no reachable tag on the 3.x line, or a tag below it: `0.0`.
 * Before v3.0.0 the major is 0 and nothing in the headers is a compatibility promise.
 */

/** @brief Semver major of this build (from the nearest tag; 0 without one). */
#define ANIRA_VERSION_MAJOR @_version_MAJOR@
/** @brief Semver minor of this build. */
#define ANIRA_VERSION_MINOR @_version_MINOR@
/** @brief Semver patch of this build. */
#define ANIRA_VERSION_PATCH @_version_PATCH@
/**
 * @brief The full `git describe --tags --dirty` string without the leading `v`,
 * e.g. `"3.0.0-alpha.1-12-gabc123"`; `"0.0.0+gabc123"` without a reachable tag.
 */
#define ANIRA_VERSION_STRING "@PROJECT_VERSION_FULL@"

/**
 * @brief Packs a semver triple into one `uint32_t` (Vulkan packing: 10 bits major,
 * 10 bits minor, 12 bits patch); `anira_version()` returns this for the library.
 */
#define ANIRA_MAKE_VERSION(major, minor, patch) \
    (((uint32_t)(major) << 22) | ((uint32_t)(minor) << 12) | (uint32_t)(patch))

/** @brief ABI major of this build: 0 until v3.0.0, then the semver major. */
#define ANIRA_ABI_MAJOR @ANIRA_ABI_MAJOR@
/** @brief ABI minor of this build: the pre-release ordinal while the major is 0. */
#define ANIRA_ABI_MINOR @ANIRA_ABI_MINOR@

#endif /* ANIRA_ABI_BUILD_INFO_H */
