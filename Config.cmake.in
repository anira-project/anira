@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

message(STATUS "Configuring anira")

# What this anira was built with. Backend linkage follows BUILD_SHARED_LIBS (a
# shared anira links shared backends, a static anira static ones), so
# ANIRA_BACKEND_LINKAGE is also the linkage of every anira::<engine> below.
set(ANIRA_WITH_LIBTORCH @ANIRA_WITH_LIBTORCH@)
set(ANIRA_WITH_ONNXRUNTIME @ANIRA_WITH_ONNXRUNTIME@)
set(ANIRA_WITH_TFLITE @ANIRA_WITH_TFLITE@)
set(ANIRA_WITH_LITERT @ANIRA_WITH_LITERT@)
set(ANIRA_WITH_EXECUTORCH @ANIRA_WITH_EXECUTORCH@)
set(ANIRA_BACKEND_LINKAGE "@ANIRA_BACKEND_LINKAGE@")
set(ANIRA_VERSION @PROJECT_VERSION_FULL@)

# Statically linked backends put Threads::Threads on their target's link interface.
# anira's own dependencies (tanh-lib's core, the queue, the JSON library) are private: tanh's
# objects are inside libanira and the other two are header-only, so nothing is looked up for them.
find_dependency(Threads)

# The engine targets anira::<engine> — the same files anira links, with the engine's
# include directories and definitions — defined from this prefix. anira links them
# PRIVATE; link one yourself only if your own code calls that engine. Before
# aniraTargets.cmake, whose $<LINK_ONLY:anira::<engine>> entries (static anira)
# refer to them.
# The shared tanh-tooling modules the helpers rely on (platform axes, hidden archive
# linking); the same files as in anira's build tree, so one code path serves both.
include("${CMAKE_CURRENT_LIST_DIR}/tanh/platform.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/tanh/symbol-policy.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/aniraEngineHelpers.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/aniraEngineTargets.cmake")

include("${CMAKE_CURRENT_LIST_DIR}/aniraTargets.cmake")

check_required_components(anira)
